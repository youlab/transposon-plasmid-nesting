# Optional overrides. Defaults are resolved from each script's location.
# No path settings are required for the bundled-data workflow.
# Full upstream runs use work/raw/ and work/processed/ inside this package.
# export NEE_PROJECT_ROOT="/path/to/this-package"
# export NEE_DATA_DIR="/path/to/this-package/work/raw"
# export NEE_RESULTS_DIR="/path/to/this-package/work/processed"
# export NEE_DATABASE_DIR="/path/to/this-package/work/raw/database"

# Needed only for NCBI downloads. Keep credentials outside the repository.
export NCBI_EMAIL="your_email@example.org"
export NCBI_API_KEY=""
export PYTHON_BIN="python"
export ISESCAN_BIN="isescan.py"
export DIAMOND_BIN="diamond"
export AMRFINDER_BIN="amrfinder"
export AMRFINDER_DB=""
export NEE_FONT_FAMILY="Arial"
# export NEE_FONT_FILE="/path/to/Arial.ttf"
# export NEE_FIGURE_QA_DIR="/path/to/installed/figure-audit-scripts"
